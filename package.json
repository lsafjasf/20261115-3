{
  "name": "mine-ventilation-sim",
  "version": "1.0.0",
  "description": "爆破后矿井通风恢复模拟：Canvas 剖面巷道、压力网络风流、瓦斯/粉尘运移与 Web Audio 报警",
  "private": true,
  "scripts": {
    "test": "node tests/verify.js && node tests/dom-smoke.js",
    "serve": "node -e \"const http=require('http'),fs=require('fs'),p=require('path');const t={'.html':'text/html','.js':'text/javascript','.css':'text/css'};http.createServer((q,r)=>{const f=p.join(process.cwd(),q.url==='/'?'index.html':q.url);fs.readFile(f,(e,d)=>{if(e){r.writeHead(404);return r.end()}r.writeHead(200,{'Content-Type':t[p.extname(f)]||'text/plain'});r.end(d)})}).listen(8080,()=>console.log('http://localhost:8080'))\""
  },
  "keywords": ["mine", "ventilation", "canvas", "web-audio", "simulation"],
  "license": "MIT"
}
